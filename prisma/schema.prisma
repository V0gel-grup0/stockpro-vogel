generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model assemblies {
  id                                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipment                                   String
  quantity                                    Int       @default(1)
  technician_id                               String?   @db.Uuid
  created_by                                  String?   @db.Uuid
  created_at                                  DateTime? @default(now()) @db.Timestamptz(6)
  profiles_assemblies_created_byToprofiles    profiles? @relation("assemblies_created_byToprofiles", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_assemblies_technician_idToprofiles profiles? @relation("assemblies_technician_idToprofiles", fields: [technician_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model clients {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  document          String              @default("")
  phone             String              @default("")
  cep               String              @default("")
  city              String              @default("")
  street            String              @default("")
  number            String              @default("")
  no_number         Boolean             @default(false)
  neighborhood      String              @default("")
  proposal_status   String              @default("Lead Frio")
  created_by        String?             @db.Uuid
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  profiles          profiles?           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders            orders[]
  crm_opportunities crm_opportunities[]
  crm_activities    crm_activities[]
  crm_tasks         crm_tasks[]
}

model components {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  category             String                 @default("")
  equipment            String                 @default("")
  equipment_names      String[]               @default([])
  supplier_id          String?                @db.Uuid
  quantity             Decimal                @default(0) @db.Decimal
  min_stock            Decimal                @default(0) @db.Decimal
  cost_price           Decimal                @default(0) @db.Decimal
  nf_number            String                 @default("")
  receita_federal_nf   String                 @default("")
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  suppliers            suppliers?             @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  equipment_components equipment_components[]
  movements            movements[]
}

model conta_azul_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String?   @db.Uuid
  status     String    @default("")
  message    String    @default("")
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  orders     orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model movements {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type               String
  item_type          String
  item_kind          String?     @default("")
  nf_item_kind       String?     @default("")
  item_id            String?     @db.Uuid
  item_name          String      @default("")
  product_id         String?     @db.Uuid
  component_id       String?     @db.Uuid
  supplier_id        String?     @db.Uuid
  order_id           String?     @db.Uuid
  quantity           Decimal     @default(0) @db.Decimal
  unit_cost          Decimal     @default(0) @db.Decimal
  total_cost         Decimal     @default(0) @db.Decimal
  nf_key             String      @default("")
  nf_number          String      @default("")
  receita_federal_nf String      @default("")
  notes              String      @default("")
  created_by         String?     @db.Uuid
  created_at         DateTime?   @default(now()) @db.Timestamptz(6)
  profiles           profiles?   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders             orders?     @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products           products?   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  components         components? @relation(fields: [component_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suppliers          suppliers?  @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model orders {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number      BigInt            @default(autoincrement())
  created_by        String?           @db.Uuid
  client_id         String?           @db.Uuid
  status            String            @default("pendente")
  item_type         String            @default("")
  item_id           String?           @db.Uuid
  equipment_name    String            @default("")
  quantity          Int               @default(1)
  total_value       Decimal           @default(0) @db.Decimal
  shipping_value    Decimal           @default(0) @db.Decimal
  tracking_code     String            @default("")
  tracking_location String            @default("")
  conta_azul_status String            @default("")
  notes             String            @default("")
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?         @default(now()) @db.Timestamptz(6)
  conta_azul_logs   conta_azul_logs[]
  movements         movements[]
  clients           clients?          @relation(fields: [client_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  profiles          profiles?         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model products {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  sku         String      @unique(map: "products_sku_unique", where: raw("(sku <> ''::text)")) @default("")
  category    String      @default("")
  subcategory String      @default("")
  cost_price  Decimal     @default(0) @db.Decimal
  sale_price  Decimal     @default(0) @db.Decimal
  quantity    Int         @default(0)
  min_stock   Int         @default(0)
  supplier_id String?     @db.Uuid
  description String      @default("")
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  suppliers   suppliers?  @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movements   movements[]
}

model profiles {
  id                                                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                    String              @unique
  role                                                     app_role            @default(representante)
  status                                                   account_status      @default(pending)
  name                                                     String              @default("")
  document                                                 String              @default("")
  phone                                                    String              @default("")
  cep                                                      String              @default("")
  city                                                     String              @default("")
  street                                                   String              @default("")
  number                                                   String              @default("")
  no_number                                                Boolean             @default(false)
  neighborhood                                             String              @default("")
  access_code                                              String?
  seller_code                                              String?
  manager_code                                             String?
  responsible_seller_id                                    String?             @db.Uuid
  responsible_manager_id                                   String?             @db.Uuid
  created_by                                               String?             @db.Uuid
  permissions                                              Json                @default("{}")
  approval_notes                                           String?
  password_hash                                            String?
  created_at                                               DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at                                               DateTime?           @default(now()) @db.Timestamptz(6)
  assemblies_assemblies_created_byToprofiles               assemblies[]        @relation("assemblies_created_byToprofiles")
  assemblies_assemblies_technician_idToprofiles            assemblies[]        @relation("assemblies_technician_idToprofiles")
  clients                                                  clients[]
  movements                                                movements[]
  orders                                                   orders[]
  crm_activities                                           crm_activities[]
  crm_tasks_assigned_to                                    crm_tasks[]         @relation("crm_tasks_assigned_toToprofiles")
  crm_tasks_created_by                                     crm_tasks[]         @relation("crm_tasks_created_byToprofiles")
  crm_opportunities_created_by                             crm_opportunities[] @relation("crm_opportunities_created_byToprofiles")
  crm_opportunities_responsible                            crm_opportunities[] @relation("crm_opportunities_responsible_idToprofiles")
  profiles_profiles_created_byToprofiles                   profiles?           @relation("profiles_created_byToprofiles", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_profiles_profiles_created_byToprofiles             profiles[]          @relation("profiles_created_byToprofiles")
  profiles_profiles_responsible_manager_idToprofiles       profiles?           @relation("profiles_responsible_manager_idToprofiles", fields: [responsible_manager_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_profiles_profiles_responsible_manager_idToprofiles profiles[]          @relation("profiles_responsible_manager_idToprofiles")
  profiles_profiles_responsible_seller_idToprofiles        profiles?           @relation("profiles_responsible_seller_idToprofiles", fields: [responsible_seller_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_profiles_profiles_responsible_seller_idToprofiles  profiles[]          @relation("profiles_responsible_seller_idToprofiles")
}

model suppliers {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  document          String       @default("")
  phone             String       @default("")
  email             String       @default("")
  cep               String       @default("")
  city              String       @default("")
  street            String       @default("")
  number            String       @default("")
  no_number         Boolean      @default(false)
  neighborhood      String       @default("")
  products          String[]     @default([])
  created_at        DateTime?    @default(now()) @db.Timestamptz(6)
  components        components[]
  supplier_products products[]
  movements         movements[]
}

enum account_status {
  pending
  approved
  rejected
  inactive
}

enum app_role {
  administrador
  gerente
  vendedor
  funcionario
  tecnico
  representante
}

model equipment_components {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipment_name    String
  component_id      String     @db.Uuid
  qty_per_equipment Decimal    @default(1) @db.Decimal(12, 2)
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  components        components @relation(fields: [component_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([equipment_name, component_id])
}

model mounted_equipments {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipment_name String   @unique
  quantity       Decimal  @default(0) @db.Decimal
  min_stock      Decimal  @default(0) @db.Decimal
  notes          String   @default("")
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
}

model crm_opportunities {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id            String           @db.Uuid
  created_by           String?          @db.Uuid
  responsible_id       String?          @db.Uuid
  title                String           @default("")
  stage                String           @default("lead")
  status               String           @default("open")
  estimated_value      Decimal          @default(0) @db.Decimal
  probability          Int              @default(0)
  next_action          String           @default("")
  next_action_at       DateTime?        @db.Timestamptz(6)
  lost_reason          String           @default("")
  notes                String           @default("")
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  updated_at           DateTime         @default(now()) @db.Timestamptz(6)
  clients              clients          @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_created_by  profiles?        @relation("crm_opportunities_created_byToprofiles", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_responsible profiles?        @relation("crm_opportunities_responsible_idToprofiles", fields: [responsible_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  crm_activities       crm_activities[]
  crm_tasks            crm_tasks[]
}

model crm_activities {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id         String             @db.Uuid
  opportunity_id    String?            @db.Uuid
  created_by        String?            @db.Uuid
  type              String
  description       String
  happened_at       DateTime           @default(now()) @db.Timestamptz(6)
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  clients           clients            @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  crm_opportunities crm_opportunities? @relation(fields: [opportunity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles          profiles?          @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model crm_tasks {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id            String             @db.Uuid
  opportunity_id       String?            @db.Uuid
  assigned_to          String?            @db.Uuid
  created_by           String?            @db.Uuid
  title                String
  description          String             @default("")
  due_at               DateTime?          @db.Timestamptz(6)
  status               String             @default("pending")
  completed_at         DateTime?          @db.Timestamptz(6)
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime           @default(now()) @db.Timestamptz(6)
  clients              clients            @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  crm_opportunities    crm_opportunities? @relation(fields: [opportunity_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_assigned_to profiles?          @relation("crm_tasks_assigned_toToprofiles", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles_created_by  profiles?          @relation("crm_tasks_created_byToprofiles", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
